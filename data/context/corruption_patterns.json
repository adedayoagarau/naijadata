{
  "known_patterns": {
    "budget_padding": {
      "description": "Inflating budget figures beyond actual needs",
      "indicators": [
        "Round numbers (exact millions/billions)",
        "Prices significantly above market rates",
        "Vague descriptions without specifications",
        "Unusual YoY increases without justification"
      ],
      "risk_score_contribution": 20
    },
    "ghost_projects": {
      "description": "Projects that exist only on paper",
      "indicators": [
        "Projects in inaccessible locations",
        "Repeated 'rehabilitation' of same asset",
        "No verifiable deliverables",
        "Contractor address unverifiable"
      ],
      "risk_score_contribution": 25
    },
    "duplicate_projects": {
      "description": "Same project appearing multiple times",
      "indicators": [
        "Identical descriptions in different MDAs",
        "Same project in federal and state budgets",
        "Similar amounts with slight variations"
      ],
      "risk_score_contribution": 30
    },
    "mandate_creep": {
      "description": "Spending outside statutory mandate",
      "indicators": [
        "Security agency doing construction",
        "Regulatory body doing service delivery",
        "Administrative office doing capital projects"
      ],
      "risk_score_contribution": 25
    },
    "phantom_training": {
      "description": "Training programs that never happen",
      "indicators": [
        "Excessive training budget relative to staff size",
        "International training for routine tasks",
        "No training reports or certificates"
      ],
      "risk_score_contribution": 20
    },
    "consultancy_abuse": {
      "description": "Excessive or unnecessary consultancy",
      "indicators": [
        "Consultancy for routine government functions",
        "No competitive bidding",
        "Repeated engagement of same consultant",
        "Deliverables not defined"
      ],
      "risk_score_contribution": 25
    },
    "procurement_splitting": {
      "description": "Splitting contracts to avoid thresholds",
      "indicators": [
        "Multiple contracts just below threshold",
        "Same vendor, multiple small contracts",
        "Sequential dates, similar amounts"
      ],
      "risk_score_contribution": 20
    },
    "election_year_spending": {
      "description": "Unusual spending patterns before elections",
      "indicators": [
        "Sharp increase in capital projects",
        "Rush contracts before election",
        "Projects in swing constituencies"
      ],
      "risk_score_contribution": 15
    }
  },
